 "font_size": 14,
 "html": "<style>\n.benkas-card{width:320px;border:2px solid #16324f;border-radius:10px;padding:14px;\n  font-family:Arial,Helvetica,sans-serif;color:#16324f}\n.benkas-card .title{font-size:15px;font-weight:bold;text-align:center;\n  border-bottom:1px solid #16324f;padding-bottom:6px;margin-bottom:8px}\n.benkas-card .row{display:flex;gap:10px}\n.benkas-card img{width:90px;height:110px;object-fit:cover;border:1px solid #999}\n.benkas-card .field{font-size:12px;margin:2px 0}\n.benkas-card .field b{display:inline-block;width:70px}\n.benkas-card .code{margin-top:8px;text-align:center;font-family:monospace;\n  font-size:13px;letter-spacing:2px;background:#f2f4f7;padding:5px;border-radius:4px}\n</style>\n<div class=\"benkas-card\">\n  <div class=\"title\">RAMSHY BIO \u2014 LABOUR ID CARD</div>\n  <div class=\"row\">\n    {% if doc.photo %}<img src=\"{{ doc.photo }}\">{% else %}<img src=\"/assets/frappe/images/ui/avatar.png\">{% endif %}\n    <div>\n      <div class=\"field\"><b>Name</b> {{ doc.labour_name }}</div>\n      <div class=\"field\"><b>Category</b> {{ doc.category or \"-\" }}</div>\n      <div class=\"field\"><b>Contractor</b> {{ doc.contractor or \"-\" }}</div>\n      <div class=\"field\"><b>Status</b> {{ doc.status }}</div>\n    </div>\n  </div>\n  <div class=\"code\">{{ doc.id_card_barcode or doc.name }}</div>\n</div>\n",
